# Environment Configuration Template

# Gemini API Key (Get from https://aistudio.google.com/app/apikeys)
GEMINI_API_KEY=your_gemini_api_key_here

# Kraken API Credentials (Get from Settings > API in Kraken Pro)
# CRITICAL: Only enable: Query Funds, Query Orders, Modify Orders, Place Orders
# DO NOT enable: Withdraw Funds
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# Optional: Configure trading parameters
# TRADING_PAIR=ONDOUSD
# CHECK_INTERVAL=30
# CONFIDENCE_THRESHOLD=0.75
# MIN_RISK_REWARD_RATIO=1.5
# MAX_DAILY_TRADES=10
